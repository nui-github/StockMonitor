# ============ Core ============
DATABASE_URL="postgresql://user:pass@host/stockmonitor?sslmode=require"   # Neon (pooled connection string)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
NEXTAUTH_SECRET=""                 # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET=""                     # openssl rand -hex 24
GOOGLE_CLIENT_ID=""                 # Google Cloud Console > OAuth 2.0 Client — ต้อง login ก่อนสร้างบทวิเคราะห์ AI ได้
GOOGLE_CLIENT_SECRET=""

# ============ Market data (server-only — ห้ามขึ้นต้น NEXT_PUBLIC_) ============
FINNHUB_API_KEY=""                 # หุ้น/ETF สหรัฐ + WebSocket realtime
TWELVEDATA_API_KEY=""              # commodity + backup
ALPHAVANTAGE_API_KEY=""            # backfill รายวัน (optional)

# ============ AI ============
ANTHROPIC_API_KEY=""
AI_MODEL_PRIMARY="claude-opus-5"   # บทวิเคราะห์หลัก
AI_MODEL_FAST="claude-haiku-4-5"   # แปล/สรุปรายชิ้น
AI_EFFORT="high"                   # low | medium | high | xhigh | max
AI_DAILY_REPORT_CAP="50"           # เพดานทั้งระบบ/วัน — เกินแล้วคืน 429
AI_USER_DAILY_CAP="10"             # เพดานต่อ user/วัน
AI_USER_HOURLY_CAP="3"             # เพดานต่อ user/ชม.
AI_REPORT_TTL_HOURS="6"            # อายุ cache ของ report (อ่านซ้ำในช่วงนี้ฟรี)
USD_THB_RATE="33"                  # ใช้แปลงต้นทุนเป็นบาทบน UI
EMBEDDING_PROVIDER="openai"        # หรือ voyage — ใช้กับ pgvector
EMBEDDING_API_KEY=""

# ============ Alerts / Web Push ============
# gen: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""     # ไม่ใช่ความลับ — ฝั่ง client ใช้ subscribe push ตรง ๆ
VAPID_PRIVATE_KEY=""                # server-only ห้ามหลุดไป client
VAPID_SUBJECT="mailto:you@example.com"

# ============ Ops ============
SENTRY_DSN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
LOG_LEVEL="info"

# ============ Feature flags ============
FEATURE_ALERTS="false"
FEATURE_AUTH="false"
FEATURE_SET_MARKET="false"
